global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'cards_nodes_exporter'
    static_configs:
      - targets:
{% for host in groups['role_cards_backend'] | default([]) %}
          - "{{ hostvars[host]['ansible_host'] }}:9100"
{% endfor %}

  - job_name: 'cards_spring_actuator'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
{% for host in groups['role_cards_backend'] | default([]) %}
          - "{{ hostvars[host]['ansible_host'] }}:8085"
{% endfor %}
